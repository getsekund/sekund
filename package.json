{
  "name": "sekund",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sekund/protocol --filter @sekund/companion --filter ./watch-sim dev",
    "relay": "pnpm --filter @sekund/protocol relay",
    "devnet:proof": "pnpm --filter @sekund/companion devnet:proof",
    "dev:companion": "pnpm --filter @sekund/companion dev",
    "dev:watch": "pnpm --filter ./watch-sim dev",
    "dev:deck": "pnpm --filter @sekund/deck dev",
    "deck:export": "pnpm --filter @sekund/deck export",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @sekund/companion e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
